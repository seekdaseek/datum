pragma language_version 0.23;

import CompactStandardLibrary;

// ===========================================================================
// datum — realisable-value solvency attestation
// ===========================================================================
//
// Proves: the depth-adjusted realisable value of a private lending book covers
// its private debt at a PUBLIC required collateral ratio, against PUBLIC venue
// reserves. Publishes the verdict and the public inputs. Publishes no position.
//
// ---------------------------------------------------------------------------
// SCALE CONVENTION
// ---------------------------------------------------------------------------
// Every quantity entering this contract is normalised to MICRO-UNITS (1e-6 of
// one whole token) before it is passed in. Raw token base units are NOT
// accepted: an 18-decimal token at any realistic pool size overflows the
// budget below, and mixing decimal conventions across venues silently corrupts
// the comparison. Normalisation is the caller's job and is checked by the
// venue-array hash, which pins the exact numbers a verifier must recompute.
//
// Normalised quantities are capped at 2^64. That is ~1.8e19 micro-units, i.e.
// ~1.8e13 whole tokens, which is above any real pool reserve or book size.
//
// RATIO_SCALE = 1_000_000. requiredRatio is the collateral ratio times
// RATIO_SCALE, so 1.20x is stored as 1_200_000.
//
// ---------------------------------------------------------------------------
// OVERFLOW BUDGET — derived, not guessed
// ---------------------------------------------------------------------------
// Compact's Uint<n> is Uint<0..2^n> with an EXCLUSIVE upper bound, so a value
// of type Uint<64> has maximum 2^64 - 1. Arithmetic widens the result type
// automatically and the compiler enforces the exact declared width, so every
// intermediate below is sized from its true maximum:
//
//   q_i, X_i, Y_i, p_i, debt   <  2^64            (capped by convention above)
//   X_i + q_i                  <  2^65
//   p_i * (X_i + q_i)          <  2^129           per-slot LHS
//   Y_i * q_i                  <  2^128           per-slot RHS
//   sum(p_i) over 8 slots      <  2^67            (8 = 2^3 slots)
//   sum(p_i) * RATIO_SCALE     <  2^87            (RATIO_SCALE < 2^20)
//   debt * requiredRatio       <  2^128           overall RHS
//
// The widest intermediate is 2^129. Accumulators are declared Uint<136> —
// seven bits of headroom over the worst case, so a future change to SLOTS or
// to RATIO_SCALE does not silently sit on the boundary. The compiler's own
// limit is a maximum Uint value of 2^248 - 1, so 136 bits is well inside it.
//
// ---------------------------------------------------------------------------
// PUBLIC / PRIVATE SPLIT
// ---------------------------------------------------------------------------
// PUBLIC  (circuit parameters, written to the ledger, independently
//          recomputable): venue reserves per slot, venue identifier, block
//          height, required collateral ratio.
// PRIVATE (witness, never disclosed): position sizes, debt, claimed proceeds
//          lower bounds, commitment nonce.
//
// Venue depth is on-chain state. It is a public input on purpose: if the
// prover supplied it privately, the verdict would rest on numbers no verifier
// could check.
// ===========================================================================

// One venue slot's PUBLIC state. Eight of these form the attestation's public
// depth picture. blockHeight pins the reserves to a checkable moment so a
// verifier can fetch the same pool at the same height and get the same X, Y.
export struct VenueSlot {
  venueId: Bytes<32>;
  reserveX: Uint<64>;
  reserveY: Uint<64>;
  blockHeight: Uint<64>;
}

// ---------------------------------------------------------------------------
// LEDGER — public state
// ---------------------------------------------------------------------------

// Number of attestations published. Monotonic, so a consumer can tell a fresh
// attestation from a replayed one.
export ledger attestationCount: Counter;

// Commitment to the private book: positions + debt + nonce. Binds this
// attestation to one specific book without revealing it. The nonce prevents
// two attestations over the same book being linked by an equal commitment.
export ledger bookCommitment: Bytes<32>;

// The venue state actually used by the proof, in the clear, so anyone can
// recheck it against the chain.
export ledger venues: Vector<8, VenueSlot>;

// Hash over the whole venue array, so a verifier recomputes one value and
// compares once rather than walking eight slots field by field.
export ledger venuesHash: Bytes<32>;

// Required collateral ratio, scaled by RATIO_SCALE (1.20x -> 1_200_000).
// PUBLIC and fixed at attestation time. Never prover-chosen.
export ledger requiredRatio: Uint<64>;

// The verdict. True iff realisable proceeds cleared debt * requiredRatio.
export ledger covered: Boolean;

// Attestation time, Unix seconds.
export ledger attestedAt: Uint<64>;

// ---------------------------------------------------------------------------
// WITNESS — private state, never disclosed
// ---------------------------------------------------------------------------

// Size to be sold into each venue slot, micro-units. Unused slots are zero.
witness positionSizes(): Vector<8, Uint<64>>;

// Claimed LOWER BOUND on proceeds from each slot, micro-units. The circuit
// enforces p_i * (X_i + q_i) <= Y_i * q_i, so an overclaim fails the proof and
// an underclaim only makes the book look worse than it is.
witness claimedProceeds(): Vector<8, Uint<64>>;

// Total debt the book must cover, micro-units.
witness debtAmount(): Uint<64>;

// Commitment nonce. Must never be reused across attestations.
witness commitmentNonce(): Bytes<32>;

// ---------------------------------------------------------------------------
// COMMITMENT PREIMAGE
// ---------------------------------------------------------------------------
// The book commitment binds positions AND debt together in a single preimage,
// with the nonce supplied as the commitment randomness. Binding all three
// matters: a commitment over positions alone would stay stable while the
// prover swapped the debt figure between attestations, and a commitment
// without the nonce would let two attestations over the same book be linked
// by an equal commitment.
struct BookPreimage {
  positions: Vector<8, Uint<64>>;
  debt: Uint<64>;
}

// ---------------------------------------------------------------------------
// VENUE DIGEST
// ---------------------------------------------------------------------------
// Exported as a pure circuit so a verifier can recompute the digest in
// TypeScript from public data alone and compare it against venuesHash in one
// step. The preimage is the whole Vector<8, VenueSlot> in slot order, each
// slot in declared field order: venueId, reserveX, reserveY, blockHeight.
// It covers the identifiers and block heights, not just the reserves — a
// digest over reserves alone would let the same numbers be re-attributed to a
// different pool or a different height.
export pure circuit venueDigest(venueState: Vector<8, VenueSlot>): Bytes<32> {
  return persistentHash<Vector<8, VenueSlot>>(venueState);
}

// ---------------------------------------------------------------------------
// THE ATTESTATION
// ---------------------------------------------------------------------------
// Public inputs are circuit parameters. Private inputs arrive via witnesses.
// The circuit hard-asserts the per-slot realisability constraints and then
// COMPUTES the coverage verdict — it does not assert coverage. An insolvent
// book still produces a valid attestation; it produces one that says NOT
// COVERED. That is the point: the artefact is a measurement, not a gate.
export circuit attest(
  venueState: Vector<8, VenueSlot>,
  ratio: Uint<64>,
  timestamp: Uint<64>
): [] {
  const q = positionSizes();
  const p = claimedProceeds();
  const debt = debtAmount();
  const nonce = commitmentNonce();

  // The bar must be a real bar. A zero ratio would make every book "covered".
  assert(ratio > 0, "datum: requiredRatio must be positive");

  for (const i of 0..8) {
    const slot = venueState[i];

    // SOUNDNESS: X > 0 and Y > 0 are required on EVERY slot, padding
    // included, and they are not decoration.
    //
    // The per-slot constraint below is p*(X+q) <= Y*q. On a padding slot
    // (q = 0) it reduces to p*X <= 0, which forces p = 0 only while X > 0.
    // If X were also allowed to be 0 the constraint would read 0 <= 0, which
    // holds for every p — and an unused slot could then claim unbounded
    // proceeds and carry an insolvent book over the line. Y > 0 closes the
    // mirror case where a slot contributes proceeds from a pool with nothing
    // in it to sell into.
    assert(slot.reserveX > 0, "datum: reserveX must be positive in every slot, padding included");
    assert(slot.reserveY > 0, "datum: reserveY must be positive in every slot, padding included");

    // Realisable proceeds from selling q into constant-product reserves are
    // Y*q/(X+q). There is no division in a circuit, so the prover supplies p
    // as a claimed lower bound and the circuit checks the cross-multiplied
    // inequality instead. Overclaiming p fails here; underclaiming it only
    // makes the book look worse than it is.
    //
    // Accumulators are annotated at Uint<136> so the width is visible at the
    // point of use rather than inferred silently: p*(X+q) < 2^129 and
    // Y*q < 2^128, both inside 136 bits with headroom to spare.
    const lhs: Uint<136> = p[i] * (slot.reserveX + q[i]);
    const rhs: Uint<136> = slot.reserveY * q[i];
    assert(lhs <= rhs, "datum: claimed proceeds exceed realisable proceeds for this slot");
  }

  // Summed term by term rather than folded with a downcast. A fold into a
  // fixed-width accumulator would need an `as` on each step, and every such
  // downcast is a run-time failure path that has nothing to do with the
  // property being proved. Written out, the compiler infers the exact width:
  // eight values each under 2^64 sum to under 2^67.
  const proceeds = p[0] + p[1] + p[2] + p[3] + p[4] + p[5] + p[6] + p[7];

  // The coverage test, scale-corrected. proceeds is in micro-units; ratio is
  // scaled by RATIO_SCALE = 1_000_000 (150% is 1_500_000). Multiplying the
  // left side by RATIO_SCALE puts both sides in the same scale without
  // dividing. LHS < 2^87, RHS < 2^128.
  const isCovered = proceeds * 1000000 >= debt * ratio;

  attestationCount.increment(1);

  // DISCLOSE: the commitment is a hiding commitment over the private book.
  // What goes public is persistentCommit(positions, debt, nonce), not the
  // book. This is the intended binding artefact — it lets a later attestation
  // be checked against the same book without revealing it.
  bookCommitment = disclose(persistentCommit<BookPreimage>(
    BookPreimage { positions: q, debt: debt }, nonce));

  // DISCLOSE: venueState is a public input. Venue reserves, identifiers and
  // block heights are on-chain state that anyone can already read; publishing
  // them is what makes the attestation recheckable.
  venues = disclose(venueState);

  // DISCLOSE: a digest of the public venue array above. Public in, public out.
  venuesHash = disclose(venueDigest(venueState));

  // DISCLOSE: the required ratio is public and fixed at attestation time.
  // Publishing it is what stops the prover from choosing the bar afterwards.
  requiredRatio = disclose(ratio);

  // DISCLOSE: the verdict. This is one bit derived from the private p and
  // debt, and it is the single deliberate leak in the contract — the entire
  // product is this bit. Everything the bit is computed from stays private:
  // the book, the debt, and the per-slot proceeds are never written out.
  covered = disclose(isCovered);

  // DISCLOSE: the attestation timestamp is a public input.
  attestedAt = disclose(timestamp);
}
